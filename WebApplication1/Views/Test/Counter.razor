@using Microsoft.JSInterop
@namespace MyComponents
@using Microsoft.AspNetCore.Components.Web
@using WebApplication1
@using BlazorBootstrap;

@* @inject IJSRuntime JS; *@
@inject IMyLogger Logger;

<h3>counter: @count</h3>
<button @onclick="IncrementCount">Increment</button>

<div class="mb-3">
    <TextInput @bind-Value="@enteredText" />
</div>
<div class="mb-3">Entered text: @enteredText</div>

@code {
    private string? enteredText = null;
}

@code {
    int count = 0;
    
    protected override void OnInitialized()
    {
        // System.Diagnostics.Debug.WriteLine("Counter component initialized");
    }

    void IncrementCount()
    {   
        // System.Diagnostics.Debug.WriteLine("click");
        // JS.InvokeVoidAsync("alert", "Button Clicked!");
        Logger.Log("click");
        ++count;
    }
}